{
  "name": "product-personalizer",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:element": "ng run product-personalizer:build-element && node scripts/finalize-element.mjs",
    "serve:element": "node scripts/serve-static.mjs dist/element 4300",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:browser": "npm run build:element && vitest run --config tests/browser/vitest.config.mts",
    "test:browser:dev": "ng run product-personalizer:build-element:development && node scripts/finalize-element.mjs && vitest run --config tests/browser/vitest.config.mts",
    "test:types": "npm run build:element && tsc -p tests/types/tsconfig.json",
    "generate:fixtures": "node scripts/generate-fixtures.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/elements": "~22.2.2",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.13.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
