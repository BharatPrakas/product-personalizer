{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Dedicated Worker for Product Personalization: configurations, mappings, the public storefront
  // routes, customizations and signed order events. It owns its own D1 database (the binding below)
  // and its own object-storage bucket.
  "name": "zb-product-personalizer",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // `nodejs_compat` is REQUIRED for aws4fetch and the Buffer/crypto shims used by the S3 storage driver,
  // the webhook HMAC check and signed asset URLs — unrelated to the database, do not remove it.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  // --- Non-secret vars. Secrets are NEVER placed here; set them with `wrangler secret put` / `.dev.vars`.
  // --- Required secrets: ZB_PLUGIN_SECRET (ZenBasket's plugin secret) and ASSET_SIGNING_SECRET, plus the
  // --- storage keys of the driver in use. Vars and secrets are per Worker environment (`--env`), and an
  // --- environment's vars are NOT inherited from the top level. See README "Environment variable inventory".
  // Hourly cleanup of abandoned customizations and customer files (see CleanupService).
  "triggers": { "crons": ["17 * * * *"] },

  "vars": {
    "ENVIRONMENT": "development",
    "API_VERSION": "v1",
    // ZenBasket's id for THIS plugin (assigned at plugin registration, with the secret). A merchant token's
    // `pluginId` claim must equal it; empty = merchant authentication fails closed. There is no dev bypass:
    // locally, mint real signed tokens with `npm run dev:token`.
    "ZB_PLUGIN_ID": "",
    // Comma-separated allowlist for CORS. The hosting storefront/admin origins only.
    "CORS_ALLOWED_ORIGINS": "http://localhost:4200,http://localhost:4300",
    // Optional public asset host. Leave empty to serve every asset through the Worker's delivery route
    // (cached at the edge). If set, it must front ONLY `stores/*/product-personalization/assets/*` of the
    // bucket — never the whole bucket, which also holds private customer files. See docs/direct-uploads.md.
    "ASSET_PUBLIC_BASE_URL": "",
    // Where THIS environment serves the element's own bundled files (default fonts, sample images) —
    // the `assets/` folder of the deployed `dist/product-personalization/`. Templates store only relative
    // references (`assets/`); the storefront route resolves them against this, so the plugin's hosting
    // path can change per environment/deploy without touching stored data. Must end in `/assets/`, be
    // publicly reachable and allow CORS from every storefront origin. Empty = bundled fonts are not
    // servable and templates using them answer `personalizable: false`.
    "BUNDLED_ASSET_BASE_URL": "http://localhost:4600/assets/",
    "MAX_UPLOAD_BYTES": "15728640",
    "LOG_LEVEL": "info",
    // Local / dev object storage is AWS S3. Replace the placeholders once the bucket and region exist.
    "STORAGE_DRIVER": "s3",
    "S3_BUCKET": "zb-plugins",
    "S3_REGION": "us-west-2",
  },

  // --- D1: this Worker's dedicated SQLite database, one per environment (never shared).
  // `database_id` is environment-specific, not a secret, but each environment's real database only
  // exists once `wrangler d1 create <name>` has been run for it — ALWAYS apply migrations to a new
  // database (`wrangler d1 migrations apply <name> --env <env> [--remote]`) before pointing any
  // deployed Worker code at it; `wrangler deploy` does not do this for you.
  //   local (`wrangler dev`, no --remote): a local SQLite file; the placeholder id below is never
  //     used to reach a real database — only `wrangler dev --remote` or a deploy reaches Cloudflare.
  //   staging: created 2026-11-06 (`zb-product-personalizer-db-staging`), migrated, and validated —
  //     see the D1 migration memory / session report. Not yet deployed to (`wrangler deploy --env
  //     staging` has not been run).
  //   production: still a placeholder (`00000000-...`) — not created yet. Do not deploy production
  //     until `wrangler d1 create` + `wrangler d1 migrations apply --env production` have both run
  //     against it first.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zb-product-personalizer-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],

  "env": {
    "dev": {
      "triggers": { "crons": ["17 * * * *"] },
      "vars": {
        "ENVIRONMENT": "development",
        "API_VERSION": "v1",
        // The plugin id your signed test tokens carry (`npm run dev:token -- --plugin <id>`). Set before use.
        "ZB_PLUGIN_ID": "",
        "CORS_ALLOWED_ORIGINS": "https://dev.dashboard.getzenbasket.com/, https://dev.storefront.getzenbasket.com/, http://localhost:4200, http://localhost:4300",
        "ASSET_PUBLIC_BASE_URL": "",
        // Dev: the plugin served by the local Store Admin host (reachable only from machines running it).
        "BUNDLED_ASSET_BASE_URL": "https://plugins.zenbasketcdn.com/PRODUCT_PERSONALIZATION/assets/",
        "MAX_UPLOAD_BYTES": "15728640",
        "LOG_LEVEL": "info",
        "STORAGE_DRIVER": "r2",
      },
      "r2_buckets": [
        {
          "binding": "PERSONALIZATION_ASSETS",
          "bucket_name": "zb-plugin",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zb-plugin-product-personalization",
          "database_id": "6f815d9f-8e35-4c91-a3e7-1bebd5ec17ab",
        },
      ],
    },
    "staging": {
      "triggers": { "crons": ["17 * * * *"] },
      "vars": {
        "ENVIRONMENT": "staging",
        "API_VERSION": "v1",
        // The plugin id your signed test tokens carry (`npm run dev:token -- --plugin <id>`). Set before use.
        "ZB_PLUGIN_ID": "PRODUCT_PERSONALIZATION",
        "CORS_ALLOWED_ORIGINS": "https://staging-admin.example.com,https://staging-shop.example.com,http://localhost:4200",
        "ASSET_PUBLIC_BASE_URL": "",
        "BUNDLED_ASSET_BASE_URL": "http://localhost:4600/PRODUCT_PERSONALIZATION/assets/",
        "MAX_UPLOAD_BYTES": "15728640",
        "LOG_LEVEL": "info",
        "STORAGE_DRIVER": "R2",
        "S3_BUCKET": "zb-plugin",
        "S3_REGION": "us-west-2",
      },
      "r2_buckets": [
        {
          "binding": "PERSONALIZATION_ASSETS",
          "bucket_name": "zb-plugin",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zb-product-personalizer-db-staging",
          "database_id": "91437292-f0ff-4450-a17e-f63c469518da",
        },
      ],
    },
    "production": {
      "triggers": { "crons": ["17 * * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        "API_VERSION": "v1",
        // TODO(production): ZenBasket's plugin id for this plugin on the production platform. Unset = 401 on
        // every merchant route. The secret: `wrangler secret put ZB_PLUGIN_SECRET --env production`.
        "ZB_PLUGIN_ID": "",
        "CORS_ALLOWED_ORIGINS": "https://admin.example.com,https://shop.example.com,http://localhost:4200",
        "ASSET_PUBLIC_BASE_URL": "",
        // TODO(production): set to this environment's hosted `.../assets/` URL (see the top-level var).
        "BUNDLED_ASSET_BASE_URL": "",
        "MAX_UPLOAD_BYTES": "15728640",
        "LOG_LEVEL": "warn",
        "STORAGE_DRIVER": "r2",
        // Direct uploads: set R2_ACCOUNT_ID (var) and the R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY secrets
        // (`wrangler secret put ... --env production`); see docs/direct-uploads.md.
        "R2_BUCKET_NAME": "zb-personalization-assets-production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zb-product-personalizer-db-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PERSONALIZATION_ASSETS",
          "bucket_name": "zb-personalization-assets-production",
        },
      ],
    },
  },
}
