{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Dedicated Worker for Product Personalization: configurations, mappings, the public storefront
  // routes, customizations and signed order events. It owns its own D1 database (the binding below)
  // and its own object-storage bucket.
  "name": "zb-product-personalizer-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // `nodejs_compat` is REQUIRED for aws4fetch and Buffer/crypto shims used by the S3 storage driver
  // and the integration-credential signing code — unrelated to the database, do not remove it.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  // --- Non-secret vars. Secrets (JWT signing key, integration encryption key) are NEVER placed here;
  // --- set them with `wrangler secret put` / `.dev.vars`. See README.
  // Hourly cleanup of abandoned customizations and customer files (see CleanupService).
  "triggers": { "crons": ["17 * * * *"] },

  "vars": {
    "ENVIRONMENT": "development",
    "API_VERSION": "v1",
    // Comma-separated allowlist for CORS. The hosting storefront/admin origins only.
    "CORS_ALLOWED_ORIGINS": "http://localhost:4200,http://localhost:4300",
    // Public delivery base for intentionally-public assets. Leave empty to serve every asset through
    // the Worker's authorized delivery endpoint instead of a public R2 custom domain.
    "ASSET_PUBLIC_BASE_URL": "",
    "MAX_UPLOAD_BYTES": "15728640",
    "LOG_LEVEL": "info",
    // Local / dev object storage is AWS S3. Replace the placeholders once the bucket and region exist.
    "STORAGE_DRIVER": "s3",
    "S3_BUCKET": "zb-plugins",
    "S3_REGION": "us-west-2",
  },

  // --- D1: this Worker's dedicated SQLite database, one per environment (never shared).
  // `database_id` is environment-specific, not a secret, but each environment's real database only
  // exists once `wrangler d1 create <name>` has been run for it — ALWAYS apply migrations to a new
  // database (`wrangler d1 migrations apply <name> --env <env> [--remote]`) before pointing any
  // deployed Worker code at it; `wrangler deploy` does not do this for you.
  //   local (`wrangler dev`, no --remote): a local SQLite file; the placeholder id below is never
  //     used to reach a real database — only `wrangler dev --remote` or a deploy reaches Cloudflare.
  //   staging: created 2026-11-06 (`zb-product-personalizer-db-staging`), migrated, and validated —
  //     see the D1 migration memory / session report. Not yet deployed to (`wrangler deploy --env
  //     staging` has not been run).
  //   production: still a placeholder (`00000000-...`) — not created yet. Do not deploy production
  //     until `wrangler d1 create` + `wrangler d1 migrations apply --env production` have both run
  //     against it first.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zb-product-personalizer-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],

  "env": {
    "dev": {
      "triggers": { "crons": ["17 * * * *"] },
      "vars": {
        "ENVIRONMENT": "development",
        "API_VERSION": "v1",
        "CORS_ALLOWED_ORIGINS": "http://localhost:4200,http://localhost:4300, http://localhost:4600, http://localhost:4601",
        "ASSET_PUBLIC_BASE_URL": "",
        "MAX_UPLOAD_BYTES": "15728640",
        "LOG_LEVEL": "info",
        "STORAGE_DRIVER": "s3",
        "DEV_AUTH_BYPASS": "true",
        "DEV_STORE_ID": "dev_store",
        "S3_BUCKET": "zb-plugins",
        "S3_REGION": "us-west-2",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zb-product-personalizer-db-dev",
          "database_id": "d05823df-1c3a-448f-bc93-2599fc7a42ec",
        },
      ]
    },
    "staging": {
      "triggers": { "crons": ["17 * * * *"] },
      "vars": {
        "ENVIRONMENT": "staging",
        "API_VERSION": "v1",
        "CORS_ALLOWED_ORIGINS": "https://staging-admin.example.com,https://staging-shop.example.com,http://localhost:4200",
        "ASSET_PUBLIC_BASE_URL": "",
        "MAX_UPLOAD_BYTES": "15728640",
        "LOG_LEVEL": "info",
        "STORAGE_DRIVER": "s3",
        "S3_BUCKET": "zb-plugins",
        "S3_REGION": "us-west-2",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zb-product-personalizer-db-staging",
          "database_id": "91437292-f0ff-4450-a17e-f63c469518da",
        },
      ],
    },
    "production": {
      "triggers": { "crons": ["17 * * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        "API_VERSION": "v1",
        "CORS_ALLOWED_ORIGINS": "https://admin.example.com,https://shop.example.com,http://localhost:4200",
        "ASSET_PUBLIC_BASE_URL": "",
        "MAX_UPLOAD_BYTES": "15728640",
        "LOG_LEVEL": "warn",
        "STORAGE_DRIVER": "r2",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zb-product-personalizer-db-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PERSONALIZATION_ASSETS",
          "bucket_name": "zb-personalization-assets-production",
        },
      ],
    },
  },
}
